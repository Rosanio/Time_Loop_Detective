{
	"chilling": [
		{
			"text": "It's a nice day isn't it?",
			"type": "basic"
		}, {
			"options": [
				{
					"text": "Ride my bike"
				},
				{
					"text": "Stay inside"
				},
				{
					"text": "Beat up random girls who pass me on the street"
				}
			],
			"text": "What do you like to do on days like this?",
			"type": "prompt"
		}, {
			"options": [
				"Wow me too!",
				"Oh...",
				"Ahhhh! Someone help!"
			],
			"type": "prompt-response"
		}
	],
	"inside_house": [
		{
			"text": "What are you doing in my house?",
			"type": "basic"
		},
		{
			"text": "Are you like, some kind of creep or something?",
			"type": "basic"
		}
	],
	"missing_house_key": [
		{
			"text": "Hey!",
			"type": "basic"
		},
		{
			"text": "Did you take my key?",
			"type": "prompt",
			"options": [
				{
					"text": "Yes"
				},
				{
					"text": "No"
				}
			]
		},
		{
			"type": "prompt-action",
			"options": [
				{
					"action": "get_help_from_henry",
					"args": [
						"yes_stole_key"
					]
				},
				{
					"action": "load_dialog",
					"args": [
						"no_stole_key"
					]
				}
			]
		}
	],
	"yes_stole_key": [
		{
			"text": "I knew it! Thief!",
			"type": "basic"
		}
	],
	"no_stole_key": [
		{
			"text": "Oh? So then you won't mind if I check your pockets?",
			"type": "prompt",
			"options": [
				{
					"text": "Go ahead"
				},
				{
					"text": "No shot"
				}
			]
		},
		{
			"type": "prompt-action",
			"options": [
				{
					"action": "check_player_for_door_key",
					"args": []
				},
				{
					"action": "get_help_from_henry",
					"args": [
						"accuse_of_stealing_key"
					]
				}
			]
		}
	],
	"accuse_of_stealing_key": [
		{
			"text": "You're a liar! I know you stole my key!",
			"type": "basic"
		}
	],
	"player_does_have_key": [
		{
			"text": "You do have it!",
			"type": "basic"
		},
		{
			"text": "Give it back you liar!",
			"type": "basic"
		}
	],
	"player_does_not_have_key": [
		{
			"text": "I guess you don't have it...",
			"type": "basic"
		},
		{
			"text": "...Sorry, that was out of line",
			"type": "basic"
		},
		{
			"text": "Let me know if you see it around",
			"type": "basic"
		}
	],
	"resent_player_for_having_key": [
		{
			"text": "I don't know what you did with it, but I know you took my key!",
			"type": "basic"
		}
	],
	"ask_for_help_finding_key": [
		{
			"text": "Let me know if you see my key around",
			"type": "basic"
		},
		{
			"text": "I'd really hate to be stuck out here at night...",
			"type": "basic"
		}
	],
	"saw_player_drop_key": [
		{
			"text": "What were you doing with my key?",
			"type": "prompt",
			"options": [
				{
					"text": "I was just about to give it back to you"
				},
				{
					"text": "Nothing..."
				},
				{
					"text": "I took it when you weren't looking"
				}
			]
		},
		{
			"type": "prompt-response",
			"options": [
				"Yeah, likely story...",
				"Sure buddy",
				"Well, at least you're honest"
			]
		}
	]
}
